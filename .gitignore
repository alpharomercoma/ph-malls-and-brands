# HTTP response cache. Large, regenerable, and rewritten in place on every
# re-run, so it is scratch space rather than provenance. The snapshots are the
# record of what was scraped.
data/cache/

# Mirror of the newest snapshot, produced by any stage. Derived, not source.
data/snapshots/latest/

# Local overrides. .env.example is committed; .env is not.
.env

.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
